# SIPANTAU CIREBON - Environment Variables Example
# Copy this file to .env and fill in your actual values
# JANGAN commit file .env ke version control!

# ==========================================
# SERVER & DATABASE
# ==========================================
PORT=5000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/laporan_fasilitas?schema=public"
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
JWT_EXPIRES_IN=1d
NODE_ENV=development

# ==========================================
# FRONTEND & CORS
# ==========================================
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ==========================================
# EMAIL NOTIFICATIONS (Nodemailer)
# ==========================================
ENABLE_EMAIL_NOTIFICATION=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="SIPANTAU CIREBON <no-reply@sipantau.id>"

# ==========================================
# AI CHATBOT (OpenRouter)
# ==========================================
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ==========================================
# WHATSAPP GATEWAY (Fonnte)
# ==========================================
# Aktifkan notifikasi WhatsApp
WHATSAPP_ENABLED=true
# Provider: fonnte | meta | twilio | custom
WHATSAPP_PROVIDER=fonte
# Nomor admin untuk notifikasi sistem (format internasional tanpa +)
# ADMIN_WHATSAPP_NUMBER=6283190039713 (deprecated - gunakan FONNTE_ADMIN_RECIPIENTS)

# Konfigurasi Fonte WhatsApp Gateway
# Dapatkan dari dashboard Fonnte: https://fonnte.com
FONTE_API_URL=https://api.fonnte.com
# --- Integrasi Fonnte WhatsApp (kanal WhatsApp utama) ---
# Docs: https://docs.fonnte.com/api-send-message/
# Aktif/nonaktif kanal Fonnte
FONNTE_ENABLED=true
# Token Fonnte (dashboard Fonnte). JANGAN pernah di-commit.
# Kosong = konfigurasi belum lengkap, notifikasi WhatsApp tidak dikirim.
FONNTE_TOKEN=
FONNTE_API_URL=https://api.fonnte.com
# Nomor penerima notifikasi admin (dipisah koma, format internasional tanpa +)
FONNTE_ADMIN_RECIPIENTS=6285147722749
FONNTE_TIMEOUT_MS=15000
FONNTE_MAX_RETRIES=3
FONNTE_RETRY_DELAY_MS=5000
FONNTE_MIN_INTERVAL_MS=2000
FONNTE_MAX_PER_MINUTE=20

# --- Integrasi & AI Chatbot Provider ---
# Kunci enkripsi AES-256-GCM untuk token/API Key integrasi.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WAJIB disimpan di server (jangan di-commit). Token yang disimpan lewat
# halaman Konfigurasi Integrasi TIDAK AKAN tersimpan bila kunci ini kosong.
INTEGRATION_ENCRYPTION_KEY=

# Chatbot AI (fallback bila admin belum menyimpan konfigurasi di database).
AI_CHATBOT_ENABLED=true
AI_PROVIDER=openrouter
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openai/gpt-4o-mini
AI_TEMPERATURE=0.3
AI_MAX_TOKENS=800
AI_TIMEOUT_MS=30000
# AI_SYSTEM_PROMPT=
# AI_API_KEY= (opsional; default memakai OPENROUTER_API_KEY)
# FONTE_API_TOKEN= (deprecated - tidak dipakai lagi)
# FONTE_DEVICE_ID tidak diperlukan untuk API v1 (1 API key = 1 device)
FONTE_WEBHOOK_SECRET=your-webhook-secret

# Template WhatsApp (opsional, untuk template yang sudah disetujui di Meta/Fonte)
WHATSAPP_TPL_NEW_REPORT_ADMIN=new_report_admin
WHATSAPP_TPL_NEW_REPORT_USER=new_report_user
WHATSAPP_TPL_STATUS_UPDATE=status_update
WHATSAPP_TPL_REPORT_SOLVED_ADMIN=report_solved_admin
WHATSAPP_TPL_REPORT_SOLVED_USER=report_solved_user
WHATSAPP_TPL_REG_ADMIN=user_registration_admin
WHATSAPP_TPL_REG_USER=user_registration_user
WHATSAPP_TPL_LOGIN_ALERT=login_alert

# ==========================================
# TELEGRAM BOT
# ==========================================
# 1) Buat bot lewat @BotFather -> salin token.
# 2) Buka bot Anda di Telegram, tekan Start, lalu kirim /start.
# 3) Dapatkan chat ID (mis. lewat @userinfobot atau @GetChatIDBot).
# 4) Isi nilai di backend/.env (JANGAN commit; .env sudah masuk .gitignore).
# 5) Uji manual: npm run telegram:test  (tetap bisa diuji walau enabled=false)
# 6) Baru setelah uji manual berhasil, set TELEGRAM_ENABLED=true.
# Token hanya dipakai backend dan tidak pernah dikirim ke frontend/log.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Username bot tanpa @ (dipakai untuk deep link t.me/<username>?start=<kode>)
TELEGRAM_BOT_USERNAME=
# Secret acak untuk webhook. Wajib diisi agar endpoint webhook menerima request.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=
# Masa berlaku kode penghubung (menit) dan batas percobaan per kode.
TELEGRAM_LINK_CODE_TTL_MINUTES=15
TELEGRAM_MAX_LINK_ATTEMPTS=5
# URL publik HTTPS backend (mis. https://api.domain-anda.com) untuk webhook.
# Dipakai oleh: npm run telegram:webhook
TELEGRAM_PUBLIC_URL=

# ==========================================
# ALTERNATIF: Meta WhatsApp Cloud API
# ==========================================
# WHATSAPP_PROVIDER=meta
# WHATSAPP_META_ACCESS_TOKEN=
# WHATSAPP_META_PHONE_NUMBER_ID=
# WHATSAPP_META_APP_SECRET=
# WHATSAPP_META_API_VERSION=v20.0

# ==========================================
# ALTERNATIF: Twilio WhatsApp
# ==========================================
# WHATSAPP_PROVIDER=twilio
# WHATSAPP_TWILIO_ACCOUNT_SID=
# WHATSAPP_TWILIO_AUTH_TOKEN=
# WHATSAPP_TWILIO_FROM_NUMBER=whatsapp:+14155238886

# ==========================================
# ALTERNATIF: Custom Webhook Provider
# ==========================================
# WHATSAPP_PROVIDER=custom
# WHATSAPP_CUSTOM_API_URL=https://your-webhook.com/whatsapp
# WHATSAPP_CUSTOM_API_KEY=

# ==========================================
# AI MOCK SETTINGS (Development)
# ==========================================
AI_MOCK_DELAY_MS=800
